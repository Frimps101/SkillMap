# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=skillmap
POSTGRES_USER=skillmap
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://skillmap:changeme@db:5432/skillmap

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production: set to False and add your Railway domain
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-backend.up.railway.app

# ── CORS (production) ─────────────────────────────────────────────────────────
# Add your Vercel frontend URL here (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Access token lifetime in minutes, refresh in days
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# ── Scraper service ───────────────────────────────────────────────────────────
SCRAPER_INTERNAL_URL=http://scraper:5000
# Secret shared between Django and Flask to protect internal endpoints
INTERNAL_API_KEY=change-me-internal-secret

# ── External APIs ─────────────────────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_API_KEY=
GREENHOUSE_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
